/* Data contoh: titik koordinat ibu kota bersifat perkiraan. Ganti dengan data resmi bila perlu. */
const PLACES = [
  ["Kota Banjarmasin",              "Kota",      "Banjarmasin", 114.5908, -3.3194],
  ["Kota Banjarbaru",               "Kota",      "Banjarbaru",  114.8103, -3.4572],
  ["Kabupaten Banjar",              "Kabupaten", "Martapura",   114.8467, -3.4126],
  ["Kabupaten Barito Kuala",        "Kabupaten", "Marabahan",   114.7519, -2.9981],
  ["Kabupaten Tapin",               "Kabupaten", "Rantau",      115.1681, -2.9425],
  ["Kabupaten Hulu Sungai Selatan", "Kabupaten", "Kandangan",   115.2658, -2.7728],
  ["Kabupaten Hulu Sungai Tengah",  "Kabupaten", "Barabai",     115.3858, -2.5836],
  ["Kabupaten Hulu Sungai Utara",   "Kabupaten", "Amuntai",     115.2500, -2.4167],
  ["Kabupaten Balangan",            "Kabupaten", "Paringin",    115.4667, -2.3333],
  ["Kabupaten Tabalong",            "Kabupaten", "Tanjung",     115.3828, -2.1636],
  ["Kabupaten Tanah Laut",          "Kabupaten", "Pelaihari",   114.7701, -3.7952],
  ["Kabupaten Tanah Bumbu",         "Kabupaten", "Batulicin",   115.9833, -3.4333],
  ["Kabupaten Kotabaru",            "Kabupaten", "Kotabaru",    116.2217, -3.2386]
];

const DATA = {
  type: "FeatureCollection",
  features: PLACES.map(([name, type, seat, lng, lat]) => ({
    type: "Feature",
    properties: { name, type, seat },
    geometry: { type: "Point", coordinates: [lng, lat] }
  }))
};

const state = { basemap: "streets", points: true, labels: true, terrain: false, exag: 1.5 };
const $ = (id) => document.getElementById(id);
const isMobile = () => window.innerWidth <= 768;
const hasHover = window.matchMedia("(hover: hover)").matches;

let map = null;
let popup = null;

/* ---------------- Token ---------------- */
function readToken() {
  if (MAPBOX_TOKEN) return MAPBOX_TOKEN;
  try { return sessionStorage.getItem(TOKEN_KEY) || ""; } catch (e) { return ""; }
}
function saveToken(t) {
  try { sessionStorage.setItem(TOKEN_KEY, t); } catch (e) { /* abaikan */ }
}
function showGate(msg) {
  $("gate").classList.add("show");
  $("gateErr").textContent = msg || "";
  $("tokenInput").focus();
}
$("tokenBtn").addEventListener("click", submitToken);
$("tokenInput").addEventListener("keydown", (e) => { if (e.key === "Enter") submitToken(); });
function submitToken() {
  const t = $("tokenInput").value.trim();
  if (!t.startsWith("pk.")) {
    $("gateErr").textContent = "Token harus diawali \"pk.\" (token publik Mapbox).";
    return;
  }
  saveToken(t);
  $("gate").classList.remove("show");
  initMap(t);
}

/* ---------------- Peta ---------------- */
function fitPadding() {
  if (isMobile()) return { top: 90, bottom: 40, left: 20, right: 20 };
  return { top: 40, bottom: 40, left: Math.min(380, Math.round(window.innerWidth * 0.45)), right: 60 };
}

function initMap(token) {
  if (map) { map.remove(); map = null; }
  mapboxgl.accessToken = token;

  map = new mapboxgl.Map({
    container: "map",
    style: BASEMAPS.find(b => b.id === state.basemap).style,
    bounds: KALSEL_BOUNDS,                       // titik awal: seluruh Kalimantan Selatan
    fitBoundsOptions: { padding: fitPadding() },
    attributionControl: true,
    hash: false,
    locale: { "NavigationControl.ResetBearing": "Utara di atas", "NavigationControl.ZoomIn": "Perbesar", "NavigationControl.ZoomOut": "Perkecil" }
  });

  const ctrlPos = isMobile() ? "bottom-right" : "top-right";
  map.addControl(new mapboxgl.NavigationControl({ visualizePitch: true }), ctrlPos);
  map.addControl(new mapboxgl.GeolocateControl({
    positionOptions: { enableHighAccuracy: true }, trackUserLocation: true, showUserHeading: true
  }), ctrlPos);
  map.addControl(new mapboxgl.FullscreenControl(), ctrlPos);
  map.addControl(new mapboxgl.ScaleControl({ unit: "metric" }), "bottom-left");

  map.on("style.load", () => { addCustomLayers(); applyTerrain(); });

  map.on("error", (e) => {
    const status = e && e.error && e.error.status;
    if (status === 401 || status === 403) {
      sessionStorage.removeItem(TOKEN_KEY);
      showGate("Token ditolak (401/403). Periksa token dan pembatasan URL-nya.");
    }
  });

  map.on("click", (e) => {
    if (!map.getLayer("kalsel-circle")) return;
    const f = map.queryRenderedFeatures(e.point, { layers: ["kalsel-circle"] })[0];
    if (f) openPopup(f.properties, f.geometry.coordinates);
  });

  map.on("mousemove", (e) => {
    if (map.getLayer("kalsel-circle")) {
      const over = map.queryRenderedFeatures(e.point, { layers: ["kalsel-circle"] }).length > 0;
      map.getCanvas().style.cursor = over ? "pointer" : "";
    }
    if (hasHover) renderCoord("Kursor", e.lngLat);
  });

  map.on("move", () => {
    if (!hasHover) renderCoord("Pusat peta", map.getCenter());
    const p = Math.round(map.getPitch());
    if (+$("rgPitch").value !== p) { $("rgPitch").value = p; $("outPitch").textContent = p + "°"; }
  });
}

function renderCoord(label, ll) {
  $("coord").textContent = label + ": " + ll.lat.toFixed(5) + ", " + ll.lng.toFixed(5) + "  |  zoom " + map.getZoom().toFixed(1);
}

function isDarkStyle() {
  return BASEMAPS.find(b => b.id === state.basemap).dark;
}

/* Layer kustom harus dipasang ulang setiap kali basemap (style) berganti. */
function applyTerrain() {
if (!map.getSource("kalsel")) {
  map.addSource("kalsel", {
    type: "geojson",
    data: "geojson/Jalan.geojson" // <-- BAGIAN INI YANG DIUBAH/DITULIS
  });
}

  if (!map.getLayer("kalsel-circle")) {
    map.addLayer({
      id: "kalsel-circle", type: "circle", source: "kalsel",
      layout: { visibility: state.points ? "visible" : "none" },
      paint: {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 6, 6, 12, 11],
        "circle-color": ["match", ["get", "type"], "Kota", "#f2b705", "#1f6f8b"],
        "circle-stroke-width": 2,
        "circle-stroke-color": "#ffffff"
      }
    });
  }

  if (!map.getLayer("kalsel-label")) {
    const dark = isDarkStyle();
    map.addLayer({
      id: "kalsel-label", type: "symbol", source: "kalsel",
      layout: {
        visibility: (state.points && state.labels) ? "visible" : "none",
        "text-field": ["get", "seat"],
        "text-font": ["DIN Pro Medium", "Arial Unicode MS Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 11, 12, 14],
        "text-offset": [0, 1.1],
        "text-anchor": "top",
        "text-optional": true
      },
      paint: {
        "text-color": dark ? "#ffffff" : "#17262e",
        "text-halo-color": dark ? "rgba(0,0,0,0.75)" : "#ffffff",
        "text-halo-width": 1.6
      }
    });
  }
}

function applyTerrain() {
  if (!map.getSource("mapbox-dem")) {
    map.addSource("mapbox-dem", {
      type: "raster-dem", url: "mapbox://mapbox.mapbox-terrain-dem-v1", tileSize: 512, maxzoom: 14
    });
  }
  map.setTerrain(state.terrain ? { source: "mapbox-dem", exaggeration: state.exag } : null);
}

/* ---------------- Popup ---------------- */
function popupContent(p, coords) {
  const [lng, lat] = coords;
  const el = document.createElement("div");
  el.className = "pop";

  const tag = document.createElement("span");
  tag.className = "tag" + (p.type === "Kota" ? " kota" : "");
  tag.textContent = p.type;

  const h = document.createElement("h3");
  h.textContent = p.name;

  const dl = document.createElement("dl");
  const rows = [];
  if (p.type !== "Kota") rows.push(["Ibu kota", p.seat]);
  rows.push(["Lintang", lat.toFixed(4)], ["Bujur", lng.toFixed(4)]);
  rows.forEach(([k, v]) => {
    const dt = document.createElement("dt"); dt.textContent = k;
    const dd = document.createElement("dd"); dd.textContent = v;
    dl.append(dt, dd);
  });

  const actions = document.createElement("div");
  actions.className = "pop-actions";
  const zoomBtn = document.createElement("button");
  zoomBtn.className = "btn primary"; zoomBtn.type = "button"; zoomBtn.textContent = "Zoom ke sini";
  zoomBtn.addEventListener("click", () => {
    map.flyTo({ center: coords, zoom: 12, pitch: state.terrain ? 60 : map.getPitch(), essential: true });
  });
  const gm = document.createElement("a");
  gm.className = "btn"; gm.target = "_blank"; gm.rel = "noopener";
  gm.href = "https://www.google.com/maps?q=" + lat + "," + lng;
  gm.textContent = "Buka Google Maps";
  actions.append(zoomBtn, gm);

  el.append(tag, h, dl, actions);
  return el;
}

function openPopup(props, coords) {
  if (popup) popup.remove();
  popup = new mapboxgl.Popup({ offset: 14, maxWidth: "280px", closeButton: true })
    .setLngLat(coords)
    .setDOMContent(popupContent(props, coords))
    .addTo(map);
}

/* ---------------- Panel kontrol ---------------- */
// Basemap
const bmWrap = $("basemaps");
BASEMAPS.forEach(b => {
  const btn = document.createElement("button");
  btn.type = "button"; btn.className = "bm"; btn.dataset.id = b.id;
  btn.setAttribute("aria-pressed", b.id === state.basemap ? "true" : "false");
  btn.innerHTML = '<span class="sw" style="background:' + b.sw + '"></span><span>' + b.label + "</span>";
  btn.addEventListener("click", () => setBasemap(b.id));
  bmWrap.appendChild(btn);
});
function setBasemap(id) {
  if (id === state.basemap || !map) return;
  state.basemap = id;
  bmWrap.querySelectorAll(".bm").forEach(b => b.setAttribute("aria-pressed", b.dataset.id === id ? "true" : "false"));
  map.setStyle(BASEMAPS.find(b => b.id === id).style);   // style.load akan memasang ulang layer
}

// Layer
function syncLayerVisibility() {
  if (!map) return;
  if (map.getLayer("kalsel-circle")) map.setLayoutProperty("kalsel-circle", "visibility", state.points ? "visible" : "none");
  if (map.getLayer("kalsel-label"))  map.setLayoutProperty("kalsel-label", "visibility", (state.points && state.labels) ? "visible" : "none");
  if (!state.points && popup) popup.remove();
}
$("tgPoints").addEventListener("change", (e) => { state.points = e.target.checked; syncLayerVisibility(); });
$("tgLabels").addEventListener("change", (e) => { state.labels = e.target.checked; syncLayerVisibility(); });

// Pencarian
const resultsEl = $("results");
function renderResults(q) {
  resultsEl.innerHTML = "";
  const term = q.trim().toLowerCase();
  const hits = DATA.features.filter(f => {
    const p = f.properties;
    return !term || p.name.toLowerCase().includes(term) || p.seat.toLowerCase().includes(term);
  });
  if (!hits.length) {
    const li = document.createElement("li");
    li.className = "empty"; li.textContent = "Tidak ada lokasi yang cocok.";
    resultsEl.appendChild(li);
    return;
  }
  hits.forEach(f => {
    const li = document.createElement("li");
    const b = document.createElement("button");
    b.type = "button";
    const a = document.createElement("span"); a.textContent = f.properties.name;
    const s = document.createElement("small"); s.textContent = f.properties.seat;
    b.append(a, s);
    b.addEventListener("click", () => {
      flyToFeature(f);
      if (isMobile()) setCollapsed(true);
    });
    li.appendChild(b);
    resultsEl.appendChild(li);
  });
}
function flyToFeature(f) {
  if (!map) return;
  const c = f.geometry.coordinates;
  map.flyTo({ center: c, zoom: 11, pitch: state.terrain ? 60 : map.getPitch(), essential: true });
  map.once("moveend", () => openPopup(f.properties, c));
}
$("q").addEventListener("input", (e) => renderResults(e.target.value));
renderResults("");

$("btnReset").addEventListener("click", () => {
  if (!map) return;
  if (popup) popup.remove();
  map.fitBounds(KALSEL_BOUNDS, { padding: fitPadding(), pitch: 0, bearing: 0, duration: 1200 });
});
$("btnNorth").addEventListener("click", () => { if (map) map.easeTo({ bearing: 0, duration: 600 }); });

// 3D
$("tgTerrain").addEventListener("change", (e) => {
  state.terrain = e.target.checked;
  if (!map) return;
  applyTerrain();
  map.easeTo({ pitch: state.terrain ? 60 : 0, duration: 800 });
});
$("rgExag").addEventListener("input", (e) => {
  state.exag = +e.target.value;
  $("outExag").textContent = state.exag.toFixed(1).replace(".", ",") + "×";
  if (map && state.terrain) map.setTerrain({ source: "mapbox-dem", exaggeration: state.exag });
});
$("rgPitch").addEventListener("input", (e) => {
  const v = +e.target.value;
  $("outPitch").textContent = v + "°";
  if (map) map.setPitch(v);
});

// Ciutkan / buka panel
const panel = $("panel");
function setCollapsed(c) {
  panel.classList.toggle("collapsed", c);
  $("collapseBtn").setAttribute("aria-expanded", String(!c));
  $("collapseBtn").setAttribute("aria-label", c ? "Buka panel" : "Ciutkan panel");
}
$("panelHead").addEventListener("click", () => setCollapsed(!panel.classList.contains("collapsed")));
if (isMobile()) setCollapsed(true);   // di layar kecil, mulai dengan panel tertutup

/* ---------------- Mulai ---------------- */
const startToken = readToken();
if (startToken) initMap(startToken);
else showGate();
